# Porta/host do servidor (deixe 127.0.0.1 e publique pelo nginx)
PORT=8095
HOST=127.0.0.1
# URL pública (opcional, enviada ao OpenRouter como referer)
PUBLIC_URL=

# Senha do editor (/admin)
ADMIN_TOKEN=

# OpenRouter — imagens e texto das histórias
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# ElevenLabs — narração
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_DEFAULT_VOICE=
